# OPTIONS EDGE SCANNER — Environment Configuration
#
# This app is read-only. It never places orders.
# On Vercel, store every secret below as a Sensitive environment variable
# (not a readable/plain value). Do not commit real values.
# Locally: copy this file to .env.local and fill in your own keys.

# ─── App login ───────────────────────────────────────────────
# APP_PASSWORD is the password for the /login page.
# SESSION_SECRET signs the httpOnly, Secure, SameSite=Lax session cookie
# and the short-lived Schwab OAuth state cookie.
# Use long random strings (for example: openssl rand -base64 32).
APP_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret

# ─── Cron ────────────────────────────────────────────────────
# Vercel cron sends Authorization: Bearer <CRON_SECRET>.
# The route does not accept the secret in a query string or a custom header.
CRON_SECRET=replace-with-a-long-random-secret

# ─── Tastytrade (OAuth refresh token only, read-only scope) ─
# Username/password session login was removed by tastytrade and is not used.
# Create the OAuth application with a read-only scope. This app never
# places orders or submits transactions.
# TASTYTRADE_ENV=production for the live account.
# sandbox points at the certification API and is only for testing.
TASTYTRADE_CLIENT_SECRET=your_oauth_client_secret
TASTYTRADE_REFRESH_TOKEN=your_oauth_refresh_token
TASTYTRADE_ACCOUNT_NUMBER=your_account_number
TASTYTRADE_ENV=production

# ─── Telegram alerts ────────────────────────────────────────
# 1. Message @BotFather on Telegram, send /newbot, follow prompts
# 2. Copy the bot token it gives you
# 3. Start a chat with your new bot (send /start)
# 4. Visit https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates once to read
#    your chat id, then treat that URL as secret (it contains the bot token)
# 5. Store both values as Vercel Sensitive variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ─── Grok (xAI) ─────────────────────────────────────────────
# Grok key used for alert screening and the research tab.
XAI_API_KEY=your_xai_api_key

# ─── Account (not secrets) ──────────────────────────────────
# Weekly drawdown flag is 25% of ACCOUNT_SIZE_DOLLARS. Default 5000.
# Empty, zero, or invalid keeps 5000. The loss cap stays 875 unless overridden.
# ACCOUNT_SIZE_DOLLARS=5000
# MAX_LOSS_DOLLARS=875

# ─── Alert settings (not secrets) ───────────────────────────
# Estimated flow premium (volume × mid × 100) before a contract is considered
# for a Telegram alert. Default in code is $50,000, the B floor.
# An A still needs $100,000 when the letter is assigned. Keep this at or
# below $50,000, or a B between $50,000 and $100,000 never reaches the grader.
ALERT_MIN_PREMIUM=50000
ALERT_OTM_ONLY=false
# Max Telegram alerts per Chicago trading day. Only letter A and B are sent.
# An A is sent before a B. Unset, or a value outside 1–50, uses 5.
ALERT_MAX_PER_DAY=5

# ─── Estimated flow watchlist (not a secret) ────────────────
# Comma-separated tickers for /api/flow and the cron scan.
# When unset, the scanner uses SPY, QQQ, IWM, AAPL, NVDA, TSLA, AMD,
# AMZN, MSFT, META, GOOGL, PLTR, SOFI, NFLX, COIN.
# FLOW_WATCHLIST=

# ─── Watchlist (not a secret; exposed to the browser) ───────
NEXT_PUBLIC_DEFAULT_WATCHLIST=SPY,QQQ,AAPL,TSLA,NVDA,AMZN,META,NQ,MNQ,SPX

# ─── Schwab Market Data Production (Sensitive, read-only) ───
# The Schwab developer app should have the Market Data Production product
# only. This app reads chains, quotes, and price history. It never places
# orders and never calls the trader API.
# Access tokens last about 30 minutes and are refreshed on the server.
# Refresh tokens last 7 days, so re-authorize in the browser each week
# (dashboard → Reconnect Schwab). The callback URL on the Schwab app must
# match SCHWAB_REDIRECT_URI exactly, for example
# https://<your-domain>/api/schwab/callback
# Store all three as Vercel Sensitive variables. Do not commit real values.
SCHWAB_CLIENT_ID=your_schwab_app_key
SCHWAB_CLIENT_SECRET=your_schwab_app_secret
SCHWAB_REDIRECT_URI=https://your-domain.example/api/schwab/callback

# ─── Schwab token store (Sensitive) ─────────────────────────
# Set one store. Exact names, checked in this order:
#   Vercel KV:     KV_REST_API_URL and KV_REST_API_TOKEN
#   Upstash Redis: UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN
#   Vercel Blob:   BLOB_READ_WRITE_TOKEN (private store)
# A complete KV pair wins, then a complete Upstash pair, then Blob.
# In production, if none of these are set, the dashboard says storage is
# not configured. Process memory is not used there.
# Local dev without these vars keeps tokens in process memory only.
# Sent alerts and the Gate's loss count for the day use this same store.
# There is no separate variable for the alert report.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# BLOB_READ_WRITE_TOKEN=
