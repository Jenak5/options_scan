{
  "functions": {
    "app/api/cron/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/alerts/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/flow/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/cron/candles/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/candles/backfill/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    },
    "app/api/candles/summaries/route.ts": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "30,35,40,45,50,55 13 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "*/5 14-20 * * 1-5"
